msgstr "Enrutamiento de inventario multiuplicación, órdenes de compra, gestión de proveedores y previsión de stock automatizada."

#: src/Showcase/ShowcaseFetcher.php:141
msgid "Pluximo Speed & Image Optimizer Pro"
msgstr "Pluximo Optimizador de Velocidad e Imágenes Pro"

#: src/Showcase/ShowcaseFetcher.php:143
msgid "Full CDN integration, background bulk queue, WebP/AVIF auto-compression, and CSS/JS minification."
msgstr "Integración completa con CDN, cola por lotes en segundo plano, autocompresión WebP/AVIF y minificación CSS/JS."

