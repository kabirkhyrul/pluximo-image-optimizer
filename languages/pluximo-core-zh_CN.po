#: src/Showcase/ShowcaseFetcher.php:93
msgid "Pluximo Core & Loyalty Rewards"
msgstr "Pluximo 核心与忠诚度奖励"

#: src/Showcase/ShowcaseFetcher.php:95
msgid "Customer loyalty rewards, points system, and referral engine for WordPress and WooCommerce stores."
msgstr "适用于 WordPress 和 WooCommerce 商店的客户忠诚度奖励、积分系统和推荐引擎。"

#: src/Showcase/ShowcaseFetcher.php:105
msgid "Pluximo Smart Inventory Manager"
msgstr "Pluximo 智能库存管理器"

#: src/Showcase/ShowcaseFetcher.php:107
msgid "Real-time stock management, multi-warehouse tracking, and automated stock alerts for WooCommerce."
msgstr "适用于 WooCommerce 的实时库存管理、多仓库跟踪和自动化库存警告。"

#: src/Showcase/ShowcaseFetcher.php:117
msgid "Pluximo Loyalty & Rewards Pro"
msgstr "Pluximo 忠诚度与奖励专业版"

#: src/Showcase/ShowcaseFetcher.php:119
msgid "Advanced VIP tiers, custom rewards, automated email triggers, gamification, and multi-currency support."
msgstr "高级 VIP 等级、自定义奖励、自动化电子邮件触发、游戏化和多货币支持。"

#: src/Showcase/ShowcaseFetcher.php:129
msgid "Pluximo Inventory & Warehouse Pro"
msgstr "Pluximo 库存与仓库专业版"

#: src/Showcase/ShowcaseFetcher.php:131
msgid "Multi-location inventory routing, purchase orders, supplier management, and automated stock forecasting."
msgstr "多地点库存路由、采购订单、供应商管理和自动化库存预测。"

#: src/Showcase/ShowcaseFetcher.php:141
msgid "Pluximo Speed & Image Optimizer Pro"
msgstr "Pluximo 速度与图像优化器专业版"

#: src/Showcase/ShowcaseFetcher.php:143
msgid "Full CDN integration, background bulk queue, WebP/AVIF auto-compression, and CSS/JS minification."
msgstr "完整 CDN 集成、后台批量队列、WebP/AVIF 自动压缩和 CSS/JS 压缩。"

